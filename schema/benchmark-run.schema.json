{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hashgraph-online/hol-guard-benchmark/blob/main/schema/benchmark-run.schema.json",
  "title": "HOL Guard benchmark run",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "runTimestamp",
    "author",
    "technicalReviewer",
    "testDate",
    "os",
    "versions",
    "hardware",
    "policyConfig",
    "sampleSize",
    "methodology",
    "limitations",
    "failures",
    "updateSchedule",
    "results"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "runId": { "type": "string" },
    "runTimestamp": { "type": "string", "format": "date-time" },
    "author": { "type": "string", "minLength": 1 },
    "technicalReviewer": { "type": "string", "minLength": 1 },
    "testDate": { "type": "string", "format": "date" },
    "os": { "type": "string", "minLength": 1 },
    "versions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
    "hardware": { "type": "string", "minLength": 1 },
    "policyConfig": { "type": "string", "minLength": 1 },
    "sampleSize": { "type": "integer", "minimum": 1 },
    "methodology": { "type": "string", "minLength": 1 },
    "limitations": { "type": "string", "minLength": 1 },
    "failures": { "type": "string", "minLength": 1 },
    "updateSchedule": { "type": "string", "minLength": 1 },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenarioId", "harnessId", "comparator", "outcome", "medianLatencyMs", "p95LatencyMs", "receiptCreated", "notes"],
        "properties": {
          "scenarioId": { "type": "string" },
          "harnessId": { "type": "string" },
          "comparator": { "type": "string" },
          "outcome": { "type": "string" },
          "medianLatencyMs": { "type": "number", "minimum": 0 },
          "p95LatencyMs": { "type": "number", "minimum": 0 },
          "receiptCreated": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
